<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CADisableMinimumFrameDurationOnPhone</key>
        <true/>
        <!-- System launch screen: eagle logo on the logo's navy, identical to SplashView so the hand-off is seamless. -->
        <key>UILaunchScreen</key>
        <dict>
            <key>UIImageName</key>
            <string>SplashLogo</string>
            <key>UIColorName</key>
            <string>SplashBackground</string>
            <key>UIImageRespectsSafeAreaInsets</key>
            <false/>
        </dict>
        <!-- Lets a Debug build talk to a local backend (`-apiBaseUrl http://127.0.0.1:8000/`). Only local hosts. -->
        <key>NSAppTransportSecurity</key>
        <dict>
            <key>NSAllowsLocalNetworking</key>
            <true/>
        </dict>
    </dict>
</plist>
