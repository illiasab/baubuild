{
  "openapi": "3.0.3",
  "info": {
    "title": "BAU BUILD API",
    "version": "1.0.0",
    "description": "Auth, projects, inquiries, workspace, review, and live updates. Human page: /docs"
  },
  "servers": [{ "url": "https://api.baubuild.vesperconnect.org" }],
  "tags": [
    {"name": "Auth"}, {"name": "Config"}, {"name": "Billing"}, {"name": "Profile"},
    {"name": "Projects"}, {"name": "Classes"}, {"name": "Inquiries"}, {"name": "Workspace"},
    {"name": "Review"}, {"name": "Lead"}, {"name": "Earnings"}, {"name": "Notifications"}, {"name": "Links"}
  ],
  "components": {
    "securitySchemes": {
      "bearer": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque"}
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {"type": "string"},
              "message": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "paths": {
    "/v1/auth/register": {"post": {"tags": ["Auth"], "summary": "Create an account and email a 6-digit code", "security": [], "responses": {"201": {"description": "verification_required"}, "403": {"description": "domain_not_allowed"}, "409": {"description": "email_taken"}, "503": {"description": "email_not_configured"}}}},
    "/v1/auth/verify-email": {"post": {"tags": ["Auth"], "summary": "Verify the email code and return tokens", "security": [], "responses": {"200": {"description": "access_token, refresh_token, expires_in, user, entitlement"}, "400": {"description": "invalid_code"}}}},
    "/v1/auth/resend-code": {"post": {"tags": ["Auth"], "summary": "Email another verification code", "security": [], "responses": {"200": {"description": "ok"}, "429": {"description": "too_many_attempts"}}}},
    "/v1/auth/login": {"post": {"tags": ["Auth"], "summary": "Sign in with email and password", "security": [], "responses": {"200": {"description": "access_token, refresh_token, expires_in, user, entitlement"}, "401": {"description": "invalid_credentials"}, "403": {"description": "email_not_verified or domain_not_allowed"}, "429": {"description": "too_many_attempts"}}}},
    "/v1/auth/password/forgot": {"post": {"tags": ["Auth"], "summary": "Email a password reset code", "security": [], "responses": {"200": {"description": "ok"}}}},
    "/v1/auth/password/reset": {"post": {"tags": ["Auth"], "summary": "Set a new password with the reset code", "security": [], "responses": {"200": {"description": "ok"}, "400": {"description": "invalid_code"}}}},
    "/v1/auth/refresh": {"post": {"tags": ["Auth"], "summary": "Rotate the refresh token", "security": [], "responses": {"200": {"description": "New token pair"}, "401": {"description": "unauthorized or refresh_reused"}}}},
    "/v1/auth/logout": {"post": {"tags": ["Auth"], "summary": "Revoke the current session", "security": [{"bearer": []}], "responses": {"204": {"description": "Revoked"}}}},
    "/v1/auth/sessions": {"get": {"tags": ["Auth"], "summary": "List sessions", "security": [{"bearer": []}], "responses": {"200": {"description": "sessions"}}}},
    "/v1/auth/sessions/{id}": {"delete": {"tags": ["Auth"], "summary": "Revoke one session", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Revoked"}}}},
    "/v1/config": {"get": {"tags": ["Config"], "summary": "Minimum versions, feature flags, maintenance banner", "security": [], "responses": {"200": {"description": "Config"}}}},
    "/v1/me/entitlement": {"get": {"tags": ["Config"], "summary": "bau_free, paid, or payment_required", "security": [{"bearer": []}], "responses": {"200": {"description": "Entitlement"}}}},
    "/v1/billing/plans": {"get": {"tags": ["Billing"], "summary": "Paid plans (inactive until phase 2)", "security": [], "responses": {"200": {"description": "Plans"}}}},
    "/v1/billing/apple/verify": {"post": {"tags": ["Billing"], "summary": "Verify an App Store receipt", "security": [{"bearer": []}], "responses": {"503": {"description": "billing_not_enabled"}}}},
    "/v1/billing/google/verify": {"post": {"tags": ["Billing"], "summary": "Verify a Play receipt", "security": [{"bearer": []}], "responses": {"503": {"description": "billing_not_enabled"}}}},
    "/v1/billing/checkout": {"post": {"tags": ["Billing"], "summary": "Stripe Checkout for Windows and Linux", "security": [{"bearer": []}], "responses": {"503": {"description": "billing_not_enabled"}}}},
    "/v1/billing/subscription": {"get": {"tags": ["Billing"], "summary": "Current subscription", "security": [{"bearer": []}], "responses": {"200": {"description": "Subscription"}}}},
    "/v1/billing/webhooks/{provider}": {"post": {"tags": ["Billing"], "summary": "Store or Stripe webhook", "security": [], "parameters": [{"name": "provider", "in": "path", "required": true, "schema": {"type": "string", "enum": ["apple", "google", "stripe"]}}], "responses": {"503": {"description": "billing_not_enabled"}}}},
    "/v1/me": {"get": {"tags": ["Profile"], "summary": "Current profile", "security": [{"bearer": []}], "responses": {"200": {"description": "User"}}}, "patch": {"tags": ["Profile"], "summary": "Update bio and skills", "security": [{"bearer": []}], "responses": {"200": {"description": "User"}}}},
    "/v1/me/stats": {"get": {"tags": ["Profile"], "summary": "Score, tier, earnings, approved count", "security": [{"bearer": []}], "responses": {"200": {"description": "Stats"}}}},
    "/v1/users/{id}": {"get": {"tags": ["Profile"], "summary": "Public profile", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Profile without email"}}}},
    "/v1/home": {"get": {"tags": ["Projects"], "summary": "First-paint home payload", "security": [{"bearer": []}], "responses": {"200": {"description": "Home"}}}},
    "/v1/inquiries/urgent": {"get": {"tags": ["Projects"], "summary": "Urgent project widgets", "security": [{"bearer": []}], "responses": {"200": {"description": "Urgent items"}}}},
    "/v1/projects": {"get": {"tags": ["Projects"], "summary": "Open projects", "security": [{"bearer": []}], "parameters": [{"name": "difficulty", "in": "query", "schema": {"type": "string", "enum": ["easy", "medium", "hard"]}}, {"name": "department", "in": "query", "schema": {"type": "string"}}, {"name": "class_id", "in": "query", "schema": {"type": "string"}}, {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["open"]}}, {"name": "q", "in": "query", "schema": {"type": "string"}}, {"name": "cursor", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Page"}}}},
    "/v1/projects/{id}": {"get": {"tags": ["Projects"], "summary": "Project detail and eligibility", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Project"}}}},
    "/v1/projects/{id}/join": {"post": {"tags": ["Projects"], "summary": "Join or request", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "joined or pending_approval"}, "403": {"description": "score_too_low, payment_required, or class_not_enrolled"}}}},
    "/v1/projects/{id}/membership": {"delete": {"tags": ["Projects"], "summary": "Leave a project", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Left"}}}},
    "/v1/projects/{id}/bookmark": {"put": {"tags": ["Projects"], "summary": "Bookmark", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Saved"}}}, "delete": {"tags": ["Projects"], "summary": "Remove bookmark", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Removed"}}}},
    "/v1/me/bookmarks": {"get": {"tags": ["Projects"], "summary": "Saved projects", "security": [{"bearer": []}], "responses": {"200": {"description": "Bookmarks"}}}},
    "/v1/search": {"get": {"tags": ["Projects"], "summary": "Search projects, classes, and inquiries", "security": [{"bearer": []}], "parameters": [{"name": "q", "in": "query", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Results"}}}},
    "/v1/me/classes": {"get": {"tags": ["Classes"], "summary": "Enrolled classes", "security": [{"bearer": []}], "responses": {"200": {"description": "Classes"}}}},
    "/v1/classes/{id}": {"get": {"tags": ["Classes"], "summary": "One class", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Class"}}}},
    "/v1/classes/{id}/projects": {"get": {"tags": ["Classes"], "summary": "Open projects in a class", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Projects"}}}},
    "/v1/inquiries": {"post": {"tags": ["Inquiries"], "summary": "Create a staff inquiry", "security": [{"bearer": []}], "responses": {"201": {"description": "submitted"}, "403": {"description": "role_required"}}}},
    "/v1/inquiries/mine": {"get": {"tags": ["Inquiries"], "summary": "My inquiries", "security": [{"bearer": []}], "responses": {"200": {"description": "Inquiries"}}}},
    "/v1/inquiries/{id}": {"get": {"tags": ["Inquiries"], "summary": "One inquiry", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Inquiry"}}}, "patch": {"tags": ["Inquiries"], "summary": "Edit a submitted inquiry", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Inquiry"}}}, "delete": {"tags": ["Inquiries"], "summary": "Delete a submitted inquiry", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Deleted"}}}},
    "/v1/admin/inquiries/{id}/approve": {"post": {"tags": ["Inquiries"], "summary": "Approve an inquiry", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "approved"}}}},
    "/v1/admin/inquiries/{id}/publish": {"post": {"tags": ["Inquiries"], "summary": "Publish an approved inquiry as a project", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"201": {"description": "published"}}}},
    "/v1/admin/enrollments": {"post": {"tags": ["Classes"], "summary": "Enroll a user in a class", "security": [{"bearer": []}], "responses": {"201": {"description": "Enrolled"}}}},
    "/v1/me/work": {"get": {"tags": ["Workspace"], "summary": "In progress and awaiting approval", "security": [{"bearer": []}], "responses": {"200": {"description": "Work"}}}},
    "/v1/projects/{id}/tasks": {"get": {"tags": ["Workspace"], "summary": "My tasks", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "assignee", "in": "query", "schema": {"type": "string", "enum": ["me"]}}], "responses": {"200": {"description": "Tasks"}}}},
    "/v1/tasks/{id}": {"patch": {"tags": ["Workspace"], "summary": "Change task status", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Task"}}}},
    "/v1/projects/{id}/changes": {"get": {"tags": ["Workspace"], "summary": "Branches and GitHub commits", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Changes"}}}},
    "/v1/integrations/github": {"get": {"tags": ["Workspace"], "summary": "GitHub connection", "security": [{"bearer": []}], "responses": {"200": {"description": "Status"}}}, "delete": {"tags": ["Workspace"], "summary": "Disconnect GitHub", "security": [{"bearer": []}], "responses": {"200": {"description": "Disconnected"}}}},
    "/v1/integrations/github/connect": {"post": {"tags": ["Workspace"], "summary": "Start GitHub OAuth", "security": [{"bearer": []}], "responses": {"200": {"description": "authorize_url"}, "503": {"description": "github_not_configured"}}}},
    "/v1/integrations/github/callback": {"get": {"tags": ["Workspace"], "summary": "GitHub OAuth callback", "security": [], "responses": {"200": {"description": "Connected"}}}},
    "/v1/projects/{id}/mentor/messages": {"get": {"tags": ["Mentor"], "summary": "Mentor history", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "task_id", "in": "query", "schema": {"type": "string"}}, {"name": "cursor", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "items of user and assistant messages with citations"}}}, "post": {"tags": ["Mentor"], "summary": "Ask the mentor", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "text/event-stream with delta, status, citation, done"}, "429": {"description": "quota_exceeded"}}}},
    "/v1/tasks/{id}/reviews": {"post": {"tags": ["Mentor"], "summary": "Ask for a review", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"202": {"description": "review_id"}, "429": {"description": "quota_exceeded"}}}},
    "/v1/reviews/{id}": {"get": {"tags": ["Mentor"], "summary": "Read a review", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Review with criteria and findings"}}}},
    "/v1/reviews/{id}/findings/{n}": {"patch": {"tags": ["Mentor"], "summary": "Lead override of a finding", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "n", "in": "path", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "Review"}}}},
    "/v1/tasks/{id}/mentor/kickoff": {"post": {"tags": ["Mentor"], "summary": "Task kickoff guide", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Guide"}}}},
    "/v1/tasks/{id}/mentor/readiness": {"post": {"tags": ["Mentor"], "summary": "Readiness check", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "criteria and ready"}}}},
    "/v1/tasks/{id}/mentor/tests": {"post": {"tags": ["Mentor"], "summary": "Suggested test cases", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "cases"}}}},
    "/v1/messages/{id}/feedback": {"post": {"tags": ["Mentor"], "summary": "Thumbs on a mentor message", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Saved"}}}},
    "/v1/admin/kb/documents": {"get": {"tags": ["Knowledge"], "summary": "List knowledge-base documents", "security": [{"bearer": []}], "responses": {"200": {"description": "Documents"}}}, "post": {"tags": ["Knowledge"], "summary": "Add a knowledge-base document", "security": [{"bearer": []}], "responses": {"201": {"description": "Document"}}}},
    "/v1/admin/kb/documents/{id}": {"get": {"tags": ["Knowledge"], "summary": "Read a document", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Document"}}}, "patch": {"tags": ["Knowledge"], "summary": "New document version", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Document"}}}, "delete": {"tags": ["Knowledge"], "summary": "Delete a document", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Deleted"}}}},
    "/v1/admin/kb/rules": {"post": {"tags": ["Knowledge"], "summary": "Add or replace a rule", "security": [{"bearer": []}], "responses": {"201": {"description": "Rule"}}}},
    "/v1/admin/kb/reindex": {"post": {"tags": ["Knowledge"], "summary": "Rebuild search", "security": [{"bearer": []}], "responses": {"202": {"description": "Accepted"}}}},
    "/v1/admin/kb/search": {"get": {"tags": ["Knowledge"], "summary": "Test what the mentor retrieves", "security": [{"bearer": []}], "parameters": [{"name": "q", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Hits"}}}},
    "/v1/projects/{id}/submissions": {"post": {"tags": ["Review"], "summary": "Submit a branch", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"201": {"description": "Submission"}}}},
    "/v1/me/submissions": {"get": {"tags": ["Review"], "summary": "My submissions", "security": [{"bearer": []}], "responses": {"200": {"description": "Submissions"}}}},
    "/v1/submissions/{id}": {"get": {"tags": ["Review"], "summary": "Submission timeline", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Timeline"}}}},
    "/v1/lead/queue": {"get": {"tags": ["Review"], "summary": "Submissions waiting on a lead", "security": [{"bearer": []}], "responses": {"200": {"description": "Queue"}, "403": {"description": "role_required"}}}},
    "/v1/submissions/{id}/decision": {"post": {"tags": ["Review"], "summary": "Approve or send back", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Decision"}}}},
    "/v1/me/lead-application": {"get": {"tags": ["Lead"], "summary": "Lead application stages", "security": [{"bearer": []}], "responses": {"200": {"description": "Stages"}}}, "post": {"tags": ["Lead"], "summary": "Start a lead application", "security": [{"bearer": []}], "responses": {"200": {"description": "Stages"}}}},
    "/v1/me/lead-application/exam/session": {"post": {"tags": ["Lead"], "summary": "Start a proctored exam session", "security": [{"bearer": []}], "responses": {"201": {"description": "Session token and questions"}}}},
    "/v1/me/lead-application/exam/sessions/{id}": {"post": {"tags": ["Lead"], "summary": "Submit exam answers", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Score"}}}},
    "/v1/admin/lead-applications/{user_id}/in-person": {"post": {"tags": ["Lead"], "summary": "Confirm the in-person stage", "security": [{"bearer": []}], "parameters": [{"name": "user_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Role is lead"}}}},
    "/v1/me/earnings": {"get": {"tags": ["Earnings"], "summary": "Paid bounties", "security": [{"bearer": []}], "responses": {"200": {"description": "Earnings"}}}},
    "/v1/me/payout-method": {"get": {"tags": ["Earnings"], "summary": "Payout preference", "security": [{"bearer": []}], "responses": {"200": {"description": "Inactive method"}}}, "put": {"tags": ["Earnings"], "summary": "Save a payout preference", "security": [{"bearer": []}], "responses": {"200": {"description": "Stored, not paid out"}}}},
    "/v1/notifications": {"get": {"tags": ["Notifications"], "summary": "Notifications", "security": [{"bearer": []}], "parameters": [{"name": "cursor", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Page"}}}},
    "/v1/notifications/unread-count": {"get": {"tags": ["Notifications"], "summary": "Unread count", "security": [{"bearer": []}], "responses": {"200": {"description": "unread"}}}},
    "/v1/notifications/read": {"post": {"tags": ["Notifications"], "summary": "Mark notifications read", "security": [{"bearer": []}], "responses": {"200": {"description": "unread"}}}},
    "/v1/devices": {"post": {"tags": ["Notifications"], "summary": "Register a push device", "security": [{"bearer": []}], "responses": {"201": {"description": "Device"}}}},
    "/v1/devices/{id}": {"delete": {"tags": ["Notifications"], "summary": "Unregister a device", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Removed"}}}},
    "/v1/events/stream": {"get": {"tags": ["Notifications"], "summary": "SSE live updates", "security": [{"bearer": []}], "parameters": [{"name": "Last-Event-ID", "in": "header", "schema": {"type": "string"}}], "responses": {"200": {"description": "text/event-stream"}}}},
    "/.well-known/apple-app-site-association": {"get": {"tags": ["Links"], "summary": "Apple universal links", "security": [], "responses": {"200": {"description": "AASA"}}}},
    "/.well-known/assetlinks.json": {"get": {"tags": ["Links"], "summary": "Android app links", "security": [], "responses": {"200": {"description": "Asset links"}}}},
    "/p/{id}": {"get": {"tags": ["Links"], "summary": "Shared project page", "security": [], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "HTML"}}}}
  }
}
