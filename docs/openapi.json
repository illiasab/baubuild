{
  "openapi": "3.0.3",
  "info": {
    "title": "BAU BUILD API",
    "version": "1.0.0",
    "description": "Auth, projects, inquiries, workspace, review, and live updates. Human page: /docs"
  },
  "servers": [
    {
      "url": "https://api.baubuild.vesperconnect.org"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Config"
    },
    {
      "name": "Billing"
    },
    {
      "name": "Profile"
    },
    {
      "name": "Projects"
    },
    {
      "name": "Classes"
    },
    {
      "name": "Inquiries"
    },
    {
      "name": "Workspace"
    },
    {
      "name": "Review"
    },
    {
      "name": "Lead"
    },
    {
      "name": "Earnings"
    },
    {
      "name": "Notifications"
    },
    {
      "name": "Links"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retry_after_s": {
                "type": "integer"
              }
            }
          }
        }
      },
      "Device": {
        "type": "object",
        "required": [
          "platform",
          "app_version"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "macos",
              "android",
              "windows",
              "linux",
              "web"
            ]
          },
          "app_version": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "description": "Own profile, or staff viewers on /v1/users/{id}"
          },
          "name": {
            "type": "string"
          },
          "display_name": {
            "type": "string",
            "description": "Same as name"
          },
          "initials": {
            "type": "string"
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "lead",
              "staff",
              "admin"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "role plus extra roles such as interviewer, senior_engineer"
            }
          },
          "title": {
            "type": "string",
            "nullable": true,
            "description": "e.g. Professor (staff only)"
          },
          "department": {
            "type": "string",
            "nullable": true
          },
          "github_username": {
            "type": "string",
            "nullable": true
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "entitlement": {
            "type": "object",
            "properties": {
              "tier": {
                "type": "string"
              },
              "expires_at": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "description": "First sentence of description"
          },
          "description": {
            "type": "string"
          },
          "bounty": {
            "type": "integer"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "min_score": {
            "type": "integer"
          },
          "min_score_label": {
            "type": "string"
          },
          "due_at": {
            "type": "string",
            "nullable": true
          },
          "urgent": {
            "type": "boolean"
          },
          "art_key": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "done"
            ]
          },
          "class_id": {
            "type": "string",
            "nullable": true
          },
          "class_code": {
            "type": "string",
            "nullable": true
          },
          "repo_full_name": {
            "type": "string",
            "nullable": true,
            "description": "owner/repo; bare repo names get GITHUB_ORG (default bau-build)"
          },
          "repo": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "nullable": true
              },
              "name": {
                "type": "string",
                "nullable": true
              },
              "full_name": {
                "type": "string",
                "nullable": true
              },
              "connected": {
                "type": "boolean",
                "description": "Deprecated alias of viewer_github_linked"
              },
              "viewer_github_linked": {
                "type": "boolean"
              }
            }
          },
          "joining": {
            "type": "string",
            "enum": [
              "everyone",
              "approval"
            ]
          },
          "reviewed_by": {
            "type": "string"
          },
          "reviewer_label": {
            "type": "string"
          },
          "is_bookmarked": {
            "type": "boolean"
          },
          "membership_status": {
            "type": "string",
            "enum": [
              "none",
              "member",
              "pending_approval"
            ]
          },
          "my_membership": {
            "type": "object",
            "nullable": true,
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "joined",
                  "pending_approval"
                ]
              }
            }
          },
          "eligibility": {
            "type": "object",
            "properties": {
              "eligible": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "done"
            ]
          },
          "lane": {
            "type": "string",
            "enum": [
              "assigned",
              "backlog"
            ]
          },
          "due_at": {
            "type": "string",
            "nullable": true
          },
          "due_date": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "criteria_done": {
            "type": "array",
            "items": {
              "type": "integer",
              "description": "index into acceptance_criteria"
            }
          }
        }
      },
      "Inquiry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "bounty": {
            "type": "integer"
          },
          "is_urgent": {
            "type": "boolean"
          },
          "due_at": {
            "type": "string",
            "nullable": true
          },
          "repo_url": {
            "type": "string",
            "nullable": true
          },
          "min_score": {
            "type": "integer"
          },
          "joining": {
            "type": "string"
          },
          "reviewer_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "approved",
              "published",
              "cancelled"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "draft",
              "open",
              "in_progress",
              "delivered",
              "cancelled"
            ],
            "description": "draft = not published; open = published, no member; in_progress = ≥1 member, nothing paid; delivered = project done or an approved submission was paid; cancelled"
          },
          "project_id": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "nullable": true
          },
          "cancelled_at": {
            "type": "string",
            "nullable": true
          },
          "wasted_usd": {
            "type": "integer",
            "description": "Unpaid bounty when cancelled"
          }
        }
      },
      "InquiryInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "bounty": {
            "type": "integer"
          },
          "is_urgent": {
            "type": "boolean"
          },
          "due_at": {
            "type": "string",
            "nullable": true
          },
          "repo_url": {
            "type": "string",
            "nullable": true
          },
          "min_score": {
            "type": "integer"
          },
          "joining": {
            "type": "string"
          },
          "reviewer_type": {
            "type": "string"
          }
        }
      },
      "StaffOverview": {
        "type": "object",
        "properties": {
          "raised_usd": {
            "type": "integer"
          },
          "wasted_usd": {
            "type": "integer"
          },
          "open": {
            "type": "integer"
          },
          "in_progress": {
            "type": "integer"
          },
          "delivered": {
            "type": "integer"
          },
          "needs_attention": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "WorldProject": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "project_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "SeniorEngineer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "github_username": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ChangeCommit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sha": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "description": "Commit message sent with the submission; falls back to the branch name"
          },
          "branch": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "sent_back"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "with_dev_lead",
              "approved",
              "changes_requested"
            ]
          },
          "url": {
            "type": "string"
          },
          "diff_url": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/v1/auth/register": {"post": {"tags": ["Auth"], "summary": "Create a verified account and sign in (no email code)", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["name", "email", "password", "device"], "properties": {"name": {"type": "string"}, "email": {"type": "string"}, "password": {"type": "string"}, "device": {"$ref": "#/components/schemas/Device"}}}}}}, "responses": {"200": {"description": "Signed in", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenPair"}}}}, "400": {"description": "invalid_body"}, "403": {"description": "domain_not_allowed (checked first)"}, "409": {"description": "email_taken"}, "422": {"description": "weak_password"}}}},
    "/v1/auth/verify-email": {"post": {"tags": ["Auth"], "summary": "Removed: there is no email code", "deprecated": true, "security": [], "responses": {"501": {"description": "not_available — no email step; password reset is done by an admin"}}}},
    "/v1/auth/resend-code": {"post": {"tags": ["Auth"], "summary": "Removed: there is no email code", "deprecated": true, "security": [], "responses": {"501": {"description": "not_available — no email step; password reset is done by an admin"}}}},
    "/v1/auth/login": {"post": {"tags": ["Auth"], "summary": "Sign in with email and password", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["email", "password", "device"], "properties": {"email": {"type": "string"}, "password": {"type": "string"}, "device": {"$ref": "#/components/schemas/Device"}}}}}}, "responses": {"200": {"description": "Signed in", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenPair"}}}}, "401": {"description": "invalid_credentials"}, "403": {"description": "domain_not_allowed"}, "429": {"description": "too_many_attempts (retry_after_s)"}}}},
    "/v1/auth/password/forgot": {"post": {"tags": ["Auth"], "summary": "Removed: ask an admin to reset the password", "deprecated": true, "security": [], "responses": {"501": {"description": "not_available — no email step; password reset is done by an admin"}}}},
    "/v1/auth/password/reset": {"post": {"tags": ["Auth"], "summary": "Removed: ask an admin to reset the password", "deprecated": true, "security": [], "responses": {"501": {"description": "not_available — no email step; password reset is done by an admin"}}}},
    "/v1/auth/refresh": {"post": {"tags": ["Auth"], "summary": "Rotate the refresh token", "security": [], "responses": {"200": {"description": "New token pair", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenPair"}}}}, "401": {"description": "unauthorized or refresh_reused"}, "403": {"description": "domain_not_allowed"}}, "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["refresh_token"], "properties": {"refresh_token": {"type": "string"}}}}}}}},
    "/v1/auth/logout": {"post": {"tags": ["Auth"], "summary": "Revoke the current session", "security": [{"bearer": []}], "responses": {"204": {"description": "Revoked"}}}},
    "/v1/auth/sessions": {"get": {"tags": ["Auth"], "summary": "List sessions", "security": [{"bearer": []}], "responses": {"200": {"description": "sessions"}}}},
    "/v1/auth/sessions/{id}": {"delete": {"tags": ["Auth"], "summary": "Revoke one session", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Revoked"}}}},
    "/v1/config": {"get": {"tags": ["Config"], "summary": "Minimum versions, feature flags, maintenance banner", "security": [], "responses": {"200": {"description": "Config"}}}},
    "/v1/me/entitlement": {"get": {"tags": ["Config"], "summary": "bau_free, paid, or payment_required", "security": [{"bearer": []}], "responses": {"200": {"description": "Entitlement"}}}},
    "/v1/billing/plans": {"get": {"tags": ["Billing"], "summary": "Paid plans (inactive until phase 2)", "security": [], "responses": {"200": {"description": "Plans"}}}},
    "/v1/billing/apple/verify": {"post": {"tags": ["Billing"], "summary": "Verify an App Store receipt", "security": [{"bearer": []}], "responses": {"503": {"description": "billing_not_enabled"}}}},
    "/v1/billing/google/verify": {"post": {"tags": ["Billing"], "summary": "Verify a Play receipt", "security": [{"bearer": []}], "responses": {"503": {"description": "billing_not_enabled"}}}},
    "/v1/billing/checkout": {"post": {"tags": ["Billing"], "summary": "Stripe Checkout for Windows and Linux", "security": [{"bearer": []}], "responses": {"503": {"description": "billing_not_enabled"}}}},
    "/v1/billing/subscription": {"get": {"tags": ["Billing"], "summary": "Current subscription", "security": [{"bearer": []}], "responses": {"200": {"description": "Subscription"}}}},
    "/v1/billing/webhooks/{provider}": {"post": {"tags": ["Billing"], "summary": "Store or Stripe webhook", "security": [], "parameters": [{"name": "provider", "in": "path", "required": true, "schema": {"type": "string", "enum": ["apple", "google", "stripe"]}}], "responses": {"503": {"description": "billing_not_enabled"}}}},
    "/v1/me": {"get": {"tags": ["Profile"], "summary": "Current profile", "security": [{"bearer": []}], "responses": {"200": {"description": "User", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/User"}}}}}}, "patch": {"tags": ["Profile"], "summary": "Update the profile (all fields optional)", "security": [{"bearer": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"display_name": {"type": "string", "description": "or name; 1–80 chars"}, "name": {"type": "string"}, "bio": {"type": "string", "description": "0–280 chars; empty allowed"}, "skills": {"type": "array", "items": {"type": "string"}}, "github_username": {"type": "string", "nullable": true}, "department": {"type": "string", "nullable": true}, "title": {"type": "string", "nullable": true, "description": "staff/admin only, else 403 role_required"}}}}}}, "responses": {"200": {"description": "User", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/User"}}}}, "400": {"description": "invalid_body"}, "403": {"description": "role_required (title on a student)"}}}},
    "/v1/me/stats": {"get": {"tags": ["Profile"], "summary": "Score, tier, earnings, approved count", "security": [{"bearer": []}], "responses": {"200": {"description": "Stats"}}}},
    "/v1/users/{id}": {"get": {"tags": ["Profile"], "summary": "Public profile (title, bio, skills, github_username, roles; email for staff viewers)", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "User", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/User"}}}}}}},
    "/v1/home": {"get": {"tags": ["Projects"], "summary": "First-paint home payload", "security": [{"bearer": []}], "responses": {"200": {"description": "Home"}}}},
    "/v1/inquiries/urgent": {"get": {"tags": ["Projects"], "summary": "Urgent project widgets", "security": [{"bearer": []}], "responses": {"200": {"description": "Urgent items"}}}},
    "/v1/projects": {"get": {"tags": ["Projects"], "summary": "Open projects", "security": [{"bearer": []}], "parameters": [{"name": "difficulty", "in": "query", "schema": {"type": "string", "enum": ["easy", "medium", "hard"]}}, {"name": "department", "in": "query", "schema": {"type": "string"}}, {"name": "class_id", "in": "query", "schema": {"type": "string"}}, {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["open"]}}, {"name": "q", "in": "query", "schema": {"type": "string"}}, {"name": "cursor", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Page", "content": {"application/json": {"schema": {"type": "object", "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Project"}}, "next_cursor": {"type": "string", "nullable": true}}}}}}}}},
    "/v1/projects/{id}": {"get": {"tags": ["Projects"], "summary": "Project detail and eligibility", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Project", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Project"}}}}}}},
    "/v1/projects/{id}/join": {"post": {"tags": ["Projects"], "summary": "Join or request", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "joined or pending_approval"}, "403": {"description": "score_too_low, payment_required, or class_not_enrolled"}}}},
    "/v1/projects/{id}/membership": {"delete": {"tags": ["Projects"], "summary": "Leave a project", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Left"}}}},
    "/v1/projects/{id}/bookmark": {"put": {"tags": ["Projects"], "summary": "Bookmark", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Saved"}}}, "delete": {"tags": ["Projects"], "summary": "Remove bookmark", "security": [{"bearer": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Removed"}}}},
    "/v1/me/bookmarks": {"get": {"tags": ["Projects"], "summary": "Saved projects", "security": [{"bearer": []}], "responses": {"200": {"description": "Bookmarks"}}}},
    "/v1/search": {"get": {"tags": ["Projects"], "summary": "Search projects, classes, and inquiries", "security": [{"bearer": []}], "parameters": [{"name": "q", "in": "query", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Results"}}}},
